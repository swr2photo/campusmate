# Public client configuration. These values are included in the app bundle.
# Optional: enable only after the custom domain is bound to the avatar bucket
# and its CDN caching has been verified. Empty keeps existing delivery URLs.
# Example verified host: images.getcampusmate.app
EXPO_PUBLIC_PROFILE_CDN_DOMAIN=

# Restricted Maps SDK keys; native rebuild required after a change.
CAMPUSMATE_ANDROID_MAPS_SDK_KEY=
CAMPUSMATE_IOS_MAPS_SDK_KEY=
# Enable only after server APIs, migrations, restrictive rules and minimum-build rollout.
CAMPUSMATE_PLUS_BACKEND_ENABLED=false
CAMPUSMATE_SECURE_DISCOVERY_ENABLED=false
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# AdMob app IDs require a native rebuild. Native units are public configuration.
CAMPUSMATE_NATIVE_ADS_ENABLED=false
CAMPUSMATE_ANDROID_ADMOB_APP_ID=
CAMPUSMATE_IOS_ADMOB_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_NATIVE_UNIT_ID=
EXPO_PUBLIC_ADMOB_IOS_NATIVE_UNIT_ID=
