{
  "react-native-google-mobile-ads": {
    "android_sdk": "classic",
    "delay_app_measurement_init": true
  },
  "expo": {
    "name": "CampusMate",
    "slug": "campusmate",
    "scheme": "campusmate",
    "version": "3.1.2",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.campusmate.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "CampusMate ใช้กล้องเพื่อวิดีโอคอลและส่งรูปในห้องแชต ตามความยินยอมของคุณ",
        "NSMicrophoneUsageDescription": "CampusMate ใช้ไมโครโฟนเพื่อโทรด้วยเสียง วิดีโอคอล และส่งข้อความเสียง ตามความยินยอมของคุณ",
        "NSPhotoLibraryUsageDescription": "CampusMate เข้าถึงคลังรูปภาพเฉพาะเมื่อคุณเลือกส่งรูปหรือวิดีโอในห้องแชต",
        "NSLocationWhenInUseUsageDescription": "CampusMate ใช้ตำแหน่งขณะใช้งานเพื่อคำนวณระยะทางกับเพื่อนและจุดนัดหมายในรั้วมหาวิทยาลัย พิกัดจริงไม่ถูกแสดงบนโปรไฟล์สาธารณะ",
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.campusmate.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 86,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E6FE0"
      },
      "permissions": [
        "com.android.vending.BILLING",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.VIBRATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "ionicons",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5FAFF",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#F5FAFF",
            "image": "./assets/adaptive-icon.png"
          }
        }
      ],
      "expo-status-bar",
      "expo-asset",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CampusMate ใช้ตำแหน่งเพื่อหาเพื่อนใกล้เคียงและจุดนัดหมายในรั้วมหาวิทยาลัย พิกัดจริงไม่ถูกแสดงบนโปรไฟล์สาธารณะ",
          "locationWhenInUsePermission": "CampusMate ใช้ตำแหน่งขณะใช้งานเพื่อคำนวณระยะทางกับเพื่อนและจุดนัดหมาย พิกัดจริงไม่ถูกแสดงบนโปรไฟล์สาธารณะ"
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#237BE7",
          "defaultChannel": "messages"
        }
      ],
      "expo-task-manager",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "expo-media-library",
        {
          "photosPermission": "อนุญาตให้ CampusMate เข้าถึงคลังรูปภาพเพื่อเลือกและส่งรูปภาพในห้องแชต",
          "savePhotosPermission": "อนุญาตให้ CampusMate บันทึกรูปภาพลงในเครื่อง",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-camera",
      "expo-video",
      "react-native-notify-kit",
      "expo-audio",
      "expo-image",
      "expo-maps",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics",
              "RNFBRemoteConfig"
            ]
          }
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true,
      "noxcturnalTransformWorker": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5ca64c3a-3182-460f-87f6-2342aaba4e2f"
      },
      "plusBackendEnabled": true,
      "secureDiscoveryEnabled": true,
      "revenueCatAndroidKey": "goog_wGhMIrpFIUnKKTRWhfdemIvuxOi"
    },
    "owner": "doralikon",
    "runtimeVersion": "3.1.2",
    "updates": {
      "url": "https://u.expo.dev/5ca64c3a-3182-460f-87f6-2342aaba4e2f"
    }
  }
}
