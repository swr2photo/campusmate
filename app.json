{
  "expo": {
    "name": "CampusMate",
    "slug": "campusmate",
    "scheme": "campusmate",
    "version": "2.0.18",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/login-campus-hero.png",
      "resizeMode": "cover",
      "backgroundColor": "#0B0D14"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.campusmate.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "อนุญาตให้ CampusMate เข้าถึงกล้องเพื่อใช้วิดีโอคอล",
        "NSMicrophoneUsageDescription": "อนุญาตให้ CampusMate เข้าถึงไมโครโฟนเพื่อบันทึกเสียงและโทรด้วยเสียง",
        "NSPhotoLibraryUsageDescription": "อนุญาตให้ CampusMate เข้าถึงคลังรูปภาพเพื่อส่งรูปภาพในห้องแชต"
      }
    },
    "android": {
      "package": "com.campusmate.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 58,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B5CE2"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D14",
          "image": "./assets/login-campus-hero.png",
          "imageWidth": 360,
          "resizeMode": "cover"
        }
      ],
      "expo-status-bar",
      "expo-asset",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to find nearby campus friends."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#5B5CE2",
          "defaultChannel": "messages"
        }
      ],
      "expo-task-manager",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "expo-media-library",
        {
          "photosPermission": "อนุญาตให้ CampusMate เข้าถึงคลังรูปภาพเพื่อเลือกและส่งรูปภาพในห้องแชต",
          "savePhotosPermission": "อนุญาตให้ CampusMate บันทึกรูปภาพลงในเครื่อง",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-camera",
      "expo-video",
      "react-native-notify-kit"
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5ca64c3a-3182-460f-87f6-2342aaba4e2f"
      }
    },
    "owner": "doralikon",
    "runtimeVersion": "2.0.18",
    "updates": {
      "url": "https://u.expo.dev/5ca64c3a-3182-460f-87f6-2342aaba4e2f"
    }
  }
}
