{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "pnpm": "12.10.1",
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "ios-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "rust-staging": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_BACKEND": "rust",
        "EXPO_PUBLIC_RUST_BACKEND_URL": "https://campusmate-backend-502731779521.fly.dev"
      }
    },
    "rust-staging-simulator": {
      "extends": "rust-staging",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": false,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "CAMPUSMATE_PLUS_BACKEND_ENABLED": "true",
        "CAMPUSMATE_SECURE_DISCOVERY_ENABLED": "true"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "beta",
        "releaseStatus": "completed"
      }
    },
    "closed": {
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "alpha"
      }
    },
    "open": {
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "beta",
        "releaseStatus": "completed"
      }
    }
  }
}
