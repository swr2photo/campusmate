{
  "auth": {
    "authorizedDomains": [
      "localhost",
      "127.0.0.1",
      "campusmate-7f1ab.firebaseapp.com",
      "campusmate-7f1ab.web.app"
    ],
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "CampusMate",
        "supportEmail": "support@example.com"
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/__/auth/action",
        "destination": "/reset.html"
      }
    ]
  }
}
