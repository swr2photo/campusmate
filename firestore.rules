rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    /*
      Data model used by the app:
      - users/{uid}: private profile owned by uid.
      - profiles/{uid}: public profile projection queried by signed-in users.
      - decisions/{fromUid_toUid}: one directional like/skip decision.
      - conversations/{conversationId}: two matched participants and messages.
      - spots/{spotId}: read-only campus spot data.
      Images are stored in the authenticated Cloudflare R2 worker, not Firebase Storage.
    */

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || data[field] == null || data[field] is timestamp;
    }

    function validDecision(data) {
      return data is map
        && data.keys().hasOnly([
          'fromUserId', 'toUserId', 'type', 'status', 'likeMessage', 'createdAt', 'updatedAt'
        ])
        && data.fromUserId is string
        && data.toUserId is string
        && data.fromUserId != data.toUserId
        && data.type in ['like', 'skip']
        && data.status in ['pending', 'accepted', 'rejected', 'removed']
        && data.likeMessage is string
        && data.likeMessage.size() <= 500
        && optionalTimestamp(data, 'createdAt')
        && optionalTimestamp(data, 'updatedAt');
    }

    function isDecisionParty(data) {
      return signedIn()
        && (request.auth.uid == data.fromUserId || request.auth.uid == data.toUserId);
    }

    function validConversation(data) {
      return data is map
        && data.participants is list
        && data.participants.size() == 2
        && data.participants[0] is string
        && data.participants[1] is string
        && data.participants[0] != data.participants[1]
        && data.messages is list
        && data.messages.size() <= 500
        && data.lastMessage is string
        && data.lastMessage.size() <= 1000
        && data.unreadCounts is map
        && data.participantProfiles is map;
    }

    function conversationFieldsAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'lastMessage',
        'meetupAcceptedUsers',
        'messages',
        'participantProfiles',
        'participantSettings',
        'readReceipts',
        'unreadCounts',
        'updatedAt'
      ]);
    }

    function acceptedLike(fromUid, toUid) {
      return exists(/databases/$(database)/documents/decisions/$(fromUid + '_' + toUid))
        && get(/databases/$(database)/documents/decisions/$(fromUid + '_' + toUid)).data.type == 'like'
        && get(/databases/$(database)/documents/decisions/$(fromUid + '_' + toUid)).data.status == 'accepted';
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /profiles/{userId} {
      allow read: if signedIn();
      allow write: if isOwner(userId);
    }

    match /decisions/{decisionId} {
      allow read: if signedIn() && (resource == null || isDecisionParty(resource.data));
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.fromUserId
        && decisionId == request.resource.data.fromUserId + '_' + request.resource.data.toUserId
        && validDecision(request.resource.data);
      allow update: if signedIn()
        && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);
      allow delete: if signedIn()
        && request.auth.uid == resource.data.fromUserId;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && acceptedLike(request.resource.data.participants[0], request.resource.data.participants[1])
        && acceptedLike(request.resource.data.participants[1], request.resource.data.participants[0])
        && validConversation(request.resource.data);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && conversationFieldsAllowed()
        && validConversation(request.resource.data);
      allow delete: if signedIn()
        && request.auth.uid in resource.data.participants;
    }

    match /spots/{spotId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
