# Optional Google Workspace Admin SDK / Directory API pre-check.
# If these values are omitted, the email verification link is the source of truth.
# If configured, the service account must have Domain-Wide Delegation for:
# https://www.googleapis.com/auth/admin.directory.user.readonly
GOOGLE_WORKSPACE_ADMIN_EMAIL=admin@psu.ac.th
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON_B64=

# Spotify Web API (Client Credentials) for track search — never put these in the mobile app.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Set GOOGLE_PLACES_API_KEY as a Firebase Functions Secret, not a client .env value.
# firebase functions:secrets:set GOOGLE_PLACES_API_KEY

# Enable after deploying r2-worker and binding the same Firebase/Worker secret.
# Keep R2_UPLOAD_SIGNING_KEY in secret stores, never in this file or the app.
# CAMPUSMATE_R2_WORKER_ENABLED=true
# CAMPUSMATE_R2_WORKER_DOMAIN=https://media.getcampusmate.app

# Public venue photos use a separate bucket/Worker from encrypted chat media.
CAMPUSMATE_PLACE_R2_BUCKET_NAME=campusmate-public-images
CAMPUSMATE_PLACE_CDN_DOMAIN=https://photos.getcampusmate.app
CAMPUSMATE_PLACE_PHOTOS_ENABLED=false
# Enable after configuring real store products and RevenueCat secrets.
CAMPUSMATE_PLUS_ENABLED=false
CAMPUSMATE_SECURE_DISCOVERY_ENABLED=false
CAMPUSMATE_PLUS_ALLOW_SANDBOX=false
# Secret Manager names: REVENUECAT_SECRET_API_KEY, REVENUECAT_WEBHOOK_AUTHORIZATION
# For the admin image callable: CLOUDFLARE_R2_ACCESS_KEY_ID, CLOUDFLARE_R2_SECRET_ACCESS_KEY

# AWS Rekognition & Face Liveness Verification
# Region: Recommended ap-southeast-1 (Singapore) for PSU Thailand low latency
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Temporary S3 bucket for AWS Rekognition Face Liveness session audit frames (optional)
AWS_LIVENESS_TEMP_BUCKET=campusmate-liveness-temp
# Set to true if managing AWS keys via Google Cloud / Firebase Secret Manager (firebase functions:secrets:set)
CAMPUSMATE_AWS_SECRETS_ENABLED=false
