{
  "name": "campusmate",
  "version": "1.0.0",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "main": "index.js",
  "scripts": {
    "eas-build-pre-install": "node eas-hooks/pre-install.mjs",
    "start": "expo start",
    "start:mcp": "set EXPO_UNSTABLE_MCP_SERVER=1&& expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "version:patch": "node scripts/release-version.mjs patch",
    "version:minor": "node scripts/release-version.mjs minor",
    "version:major": "node scripts/release-version.mjs major",
    "release:android": "pnpm check:animation-runtime && pnpm version:patch && pnpm check:android-config && eas build --platform android --profile production",
    "release:android:submit": "pnpm check:animation-runtime && pnpm version:patch && pnpm check:android-config && eas build --platform android --profile production && eas submit --platform android --profile production --latest",
    "backfill:discovery": "node scripts/backfill-discovery-profiles.mjs",
    "backfill:parties": "node scripts/backfill-parties.mjs",
    "test:party-rules": "firebase emulators:exec --only firestore --project demo-campusmate \"node scripts/test-party-rules.mjs\"",
    "test:party-functions": "firebase emulators:exec --only firestore --project demo-campusmate \"node scripts/test-party-functions.mjs\"",
    "version:set": "node scripts/set-version-config.mjs",
    "check:android-config": "node scripts/check-android-config.mjs",
    "check:animation-runtime": "node scripts/check-animation-runtime.mjs",
    "build:reset-page": "pnpm --dir web build",
    "build:web": "pnpm --dir web build",
    "admin:bootstrap": "node scripts/bootstrap-admin-user.mjs",
    "deploy:face-verification": "node scripts/deploy-face-verification.mjs --deploy"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@expo-google-fonts/noto-sans-thai": "^0.4.2",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/ui": "~58.0.20",
    "@expo/vector-icons": "^15.1.1",
    "@livekit/react-native": "^2.12.0",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@livekit/react-native-webrtc": "^144.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/remote-config": "^26.4.0",
    "@react-native-google-signin/google-signin": "16.1.5",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native-picker/picker": "^2.11.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "expo": "~58.0.14",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.16",
    "expo-audio": "~58.0.9",
    "expo-auth-session": "~58.0.13",
    "expo-blur": "~58.0.4",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.10",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-location": "~58.0.17",
    "expo-maps": "~58.0.9",
    "expo-media-library": "~58.0.10",
    "expo-modules-core": "~58.0.22",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-screen-capture": "~58.0.5",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.17",
    "expo-video": "~58.0.11",
    "expo-web-browser": "~58.0.6",
    "firebase": "^12.18.0",
    "jpeg-js": "^0.4.4",
    "livekit-client": "^2.22.3",
    "lottie-react-native": "~7.5.0",
    "moti": "^0.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-mobile-ads": "^17.2.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-maps": "1.29.11",
    "react-native-notify-kit": "^10.7.1",
    "react-native-purchases": "^10.11.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.13.0",
    "tweetnacl": "1.0.3",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "babel-preset-expo": "~58.0.4",
    "expo-mcp": "~0.2.4",
    "firebase-admin": "^14.3.0"
  },
  "private": true,
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
