# No credentials belong in source control. Production DB requires verified TLS.
DATABASE_URL=postgres://campusmate:CHANGE_ME@localhost:5432/campusmate?sslmode=disable
CURSOR_SECRET=REPLACE_WITH_AT_LEAST_32_CRYPTOGRAPHICALLY_RANDOM_BYTES
APP_ENV=development
BIND_HOST=127.0.0.1
PORT=8080

# --- Full platform (all optional; a feature answers 503 until configured) ---
# Realtime signals need a direct (non-pooler) session connection. A Neon
# pooler DATABASE_URL is mapped to its direct endpoint automatically.
# DATABASE_LISTEN_URL=
# Firebase session exchange and one-time legacy password check.
# FIREBASE_IDENTITY_ENABLED=true
# FIREBASE_PROJECT_ID=campusmate-7f1ab
# FIREBASE_WEB_API_KEY=
# Google Sign-In: comma-separated OAuth client IDs (iOS, Android, web).
# GOOGLE_OAUTH_CLIENT_IDS=
# Profile media (avatars, gallery) and chat media on Cloudflare R2.
# R2_ENDPOINT= R2_MEDIA_ACCESS_KEY_ID= R2_MEDIA_SECRET_ACCESS_KEY= R2_MEDIA_BUCKET= PROFILE_MEDIA_ORIGIN=
# R2_CHAT_ACCESS_KEY_ID= R2_CHAT_SECRET_ACCESS_KEY= R2_CHAT_BUCKET= CHAT_MEDIA_ORIGIN=
# or the existing upload Worker: R2_WORKER_ORIGIN= R2_UPLOAD_SIGNING_KEY=
# Image moderation (Rekognition DetectModerationLabels).
# MODERATION_REGION=ap-southeast-1
# Push (Expo). PUSH_WORKER=off runs delivery elsewhere.
# EXPO_ACCESS_TOKEN=
# Calls, places, music, membership.
# LIVEKIT_API_KEY= LIVEKIT_API_SECRET= LIVEKIT_URL=
# GOOGLE_PLACES_API_KEY=
# SPOTIFY_CLIENT_ID= SPOTIFY_CLIENT_SECRET=
# CAMPUSMATE_PLUS_ENABLED=true REVENUECAT_SECRET_API_KEY= REVENUECAT_WEBHOOK_AUTHORIZATION= REVENUECAT_PROJECT_ID=
# Browser admin console origins (CORS), https only.
# ADMIN_CONSOLE_ORIGINS=https://campusmate-7f1ab.web.app
