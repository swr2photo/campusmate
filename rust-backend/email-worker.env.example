# For the separate mail worker only; never put these in Expo public config.
# Use the API's actual controlled HTTPS origin. Pages call the same origin.
NATIVE_AUTH_EMAIL_ORIGIN=https://api.example.test
CAMPUS_EMAIL_FROM=noreply@getcampusmate.app
CAMPUS_EMAIL_FROM_NAME=CampusMate
# Choose ONE provider and inject secrets with your hosting secret manager.
# RESEND_API_KEY=
# Or verified SMTP TLS (465 implicit TLS, 587 required STARTTLS).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# The worker uses its own restricted PostgreSQL identity.
# DATABASE_URL=
APP_ENV=production
