# SERVER ONLY. Example placeholders; never copy database credentials into Expo.
# Owner/migration job only: direct hostname, privileged schema-owner identity.
DATABASE_DIRECT_URL=postgres://campusmate_schema_owner:REPLACE_WITH_OWNER_SECRET@ep-little-smoke-b30yyldu.c-4.ap-southeast-1.aws.neon.tech/campusmate?sslmode=verify-full

# API service only: a restricted SQL-created LOGIN role and pooled hostname.
# Use a DIFFERENT environment/secret for the mail worker (see below).
DATABASE_URL=postgres://campusmate_api_login:REPLACE_WITH_API_SECRET@ep-little-smoke-b30yyldu-pooler.c-4.ap-southeast-1.aws.neon.tech/campusmate?sslmode=verify-full
APP_ENV=production
DB_POOL_MODE=transaction
DB_MAX_CONNECTIONS=8
DB_MIN_CONNECTIONS=0
DB_ACQUIRE_TIMEOUT_SECONDS=8
DB_IDLE_TIMEOUT_SECONDS=60
DB_MAX_LIFETIME_SECONDS=900
CURSOR_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
BIND_HOST=0.0.0.0
PORT=8080

# MAIL WORKER separate environment:
# DATABASE_URL=postgres://campusmate_mail_login:REPLACE_WITH_MAIL_SECRET@ep-little-smoke-b30yyldu-pooler.c-4.ap-southeast-1.aws.neon.tech/campusmate?sslmode=verify-full
# DB_MAX_CONNECTIONS=2
# Also configure the selected transport's secrets and NATIVE_AUTH_EMAIL_ORIGIN.
# Do not inject DATABASE_DIRECT_URL/owner credentials into API or mail workers.
# Do not append channel_binding=require: SQLx 0.8 cannot enforce that option.
