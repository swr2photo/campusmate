rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Chat media upload fallback: strictly authenticated and bounded to 25MB max
    match /chat_media/{conversationId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && (request.resource == null || request.resource.size < 25 * 1024 * 1024);
    }

    // Deny all other unauthenticated or wildcard access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
